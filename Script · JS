(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var body = document.body;

  /* phone mockups */
  var tpl = document.getElementById('ph');
  document.querySelectorAll('[data-phone]').forEach(function(el){
    var node = tpl.content.firstElementChild.cloneNode(true);
    if(el.classList.contains('phone')){ el.innerHTML = node.innerHTML; }
    else { var w = document.createElement('div'); w.className='phone'; w.innerHTML = node.innerHTML; el.replaceWith(w); }
  });

  /* marquee skills line */
  var tech = ['n8n','Python','Claude','Gemini','AI Agents','APIs','Webhooks','Automation','Vercel','GitHub'];
  var m = document.getElementById('mq1'), h = '';
  for(var k=0;k<4;k++){ tech.forEach(function(t){ h += '<span>'+t+'</span>'; }); }
  m.innerHTML = h;

  /* preloader */
  var pre = document.getElementById('pre'), num = document.getElementById('pnum'), bar = document.getElementById('pbar');
  var nameEl = pre.querySelector('.name');

  /* split the name into letters */
  var text = nameEl.textContent, chars = [];
  nameEl.textContent = '';
  for(var i=0;i<text.length;i++){
    var s = document.createElement('span');
    s.className = 'ch' + (i===text.length-1 ? ' dot' : '');
    s.textContent = text[i]===' ' ? '\u00A0' : text[i];
    nameEl.appendChild(s);
    chars.push(s);
  }

  var finished = false;
  function finish(){
    if(finished) return;
    finished = true;
    chars.forEach(function(c,i){ c.style.transitionDelay = (i*0.025)+'s'; });
    pre.classList.add('hide');
    setTimeout(function(){
      pre.classList.add('up');
      body.classList.add('loaded');
    }, 700);
    setTimeout(function(){
      pre.style.display = 'none';
      body.style.overflow = '';
    }, 1900);
  }

  if(reduce){
    pre.style.display = 'none';
    body.classList.add('loaded');
  } else {
    body.style.overflow = 'hidden';
    var N = chars.length, OVERLAP = 3, t0 = performance.now(), dur = 2600;
    (function tick(t){
      var p = Math.min((t-t0)/dur, 1), e = 1-Math.pow(1-p, 2.2);
      num.textContent = Math.round(e*100);
      bar.style.transform = 'scaleX('+e+')';
      for(var i=0;i<N;i++){
        var cp = Math.max(0, Math.min(1, (e*(N+OVERLAP) - i)/OVERLAP));
        chars[i].style.opacity = cp;
        chars[i].style.transform = 'translateY('+((1-cp)*45)+'%)';
      }
      if(p < 1){ requestAnimationFrame(tick); }
      else { setTimeout(finish, 600); }
    })(t0);
  }

  /* reveal + counters */
  function count(el){
    var to = +el.dataset.count, s = performance.now(), d = 1400;
    (function f(t){ var p = Math.min((t-s)/d,1); el.textContent = Math.round(to*(1-Math.pow(1-p,3))); if(p<1) requestAnimationFrame(f); })(s);
  }
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting) return;
      e.target.classList.add('in');
      e.target.querySelectorAll('[data-count]').forEach(count);
      io.unobserve(e.target);
    });
  },{threshold:.15});
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });

  /* scroll spy */
  var links = document.querySelectorAll('nav a[href^="#"]:not(.logo)');
  var map = {about:'#about',why:'#about',skills:'#skills',exp:'#exp',edu:'#exp',projects:'#projects',contact:'#contact',home:'#home'};
  var spy = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting) return;
      var target = map[e.target.id];
      links.forEach(function(a){ a.classList.toggle('on', a.getAttribute('href')===target); });
    });
  },{rootMargin:'-45% 0px -50% 0px'});
  Object.keys(map).forEach(function(id){ var s = document.getElementById(id); if(s) spy.observe(s); });

  /* timeline progress */
  var tl = document.getElementById('tline');
  if(tl){
    function prog(){
      var r = tl.getBoundingClientRect(), vh = window.innerHeight;
      var p = (vh*0.6 - r.top)/r.height; p = Math.max(0,Math.min(1,p));
      tl.style.setProperty('--p', (p*100)+'%');
    }
    window.addEventListener('scroll',prog,{passive:true}); window.addEventListener('resize',prog); prog();
  }

  /* back to top */
  document.getElementById('up').addEventListener('click',function(){ window.scrollTo({top:0,behavior:reduce?'auto':'smooth'}); });

  /* contact form -> opens email app */
  document.getElementById('cform').addEventListener('submit',function(ev){
    ev.preventDefault();
    var f = ev.target, to = 'muhammadibrahimkamran@gmail.com';
    var sub = encodeURIComponent(f.s.value || 'Workflow enquiry from '+f.n.value);
    var msg = encodeURIComponent('Name: '+f.n.value+'\nEmail: '+f.e.value+'\n\n'+f.m.value);
    window.location.href = 'mailto:'+to+'?subject='+sub+'&body='+msg;
    document.getElementById('fmsg').textContent = 'Opening your email app with the message ready to send.';
  });
